{
  "Logging": {
    "LogLevel": {
      "Default": "Debug",
      "Microsoft": "Warning",
      "Microsoft.Hosting.Lifetime": "Information",
      "WorkerService1": "Debug",
      "WorkerService1.Services.BrowserHistoryService": "Information"
    }
  },
  "PerformanceAgent": {
    "PollIntervalMs": 2000,
    "AppsRefreshIntervalHours": 24,
    "DataRetentionDays": 30,
    "EnableUwpCollection": true,
    "EnableWin32Collection": true,
    "DataDirectory": "",
    "EnableConsoleOutput": false,
    "EnableDebugLogging": false
  },
  "DataSync": {
    "Enabled": true,
    "MySqlHost": "localhost",
    "MySqlPort": 3306,
    "MySqlDatabase": "performance_agent",
    "MySqlUser": "root",
    "MySqlPassword": "",
    "SyncIntervalMinutes": 5,
    "BatchSize": 50,
    "DeleteAfterSync": true
  }
}