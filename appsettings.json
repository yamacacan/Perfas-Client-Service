{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft": "Warning",
      "Microsoft.Hosting.Lifetime": "Information",
      "WorkerService1": "Information",
      "WorkerService1.Services.BrowserHistoryService": "Information",
      "WorkerService1.Services.DataSyncService": "Information"
    }
  },
  "PerformanceAgent": {
